# Basic 認証の ID とパスワード。実際の値は .env.local に書く（コミットしない）
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Firebase（Firestore）。サーバー側からだけ使う。NEXT_PUBLIC_ を付けない・コミットしない ---
# ローカル開発（pnpm dev）も、ここに書いたプロジェクトの本番の Firestore につながる（エミュレーターは使わない）
# プロジェクト ID
FIREBASE_PROJECT_ID=
# サービスアカウントのメールアドレス（Firebase App Hosting など、デフォルト認証情報を使う環境では不要）
FIREBASE_CLIENT_EMAIL=
# サービスアカウントの秘密鍵（同上）。ダブルクォートで囲み、改行は \n の 2 文字のまま 1 行で書く
FIREBASE_PRIVATE_KEY=
# 1 のときだけ Firestore の結合テストを動かす（pnpm test:firestore はフェーズ 14 で追加予定）。ふだんは空のままにする
GANTT_FIRESTORE_TEST=
