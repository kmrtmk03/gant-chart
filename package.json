{
  "name": "gant-chart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "next dev --experimental-https",
    "dev:http": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.2",
    "date-fns": "^4.4.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": "11.5.2"
    }
  }
}
